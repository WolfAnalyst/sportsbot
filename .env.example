# ====================================================================
#  sportsbot - YOUR settings.
#
#  >>> COPY this file to a new file named exactly  .env  and edit THAT. <<<
#  (Your .env is private and is never uploaded. This .example file is the
#   template that ships with updates.)
#
#  HOW TO EDIT: each setting is  NAME=value . Type your value right after
#  the = . Help is on the '#' lines ABOVE each setting. Do NOT type notes
#  after a value on the same line - it becomes part of the value and breaks
#  the bot. Lines starting with # are ignored. Use Notepad, not Word.
# ====================================================================

# Sports-only mode. LEAVE THIS EXACTLY AS-IS.
SPORTSBOT_MODE=true

# -- 1. Telegram (the account that READS the tip groups) --------------
# API_ID + API_HASH from https://my.telegram.org -> "API development tools".
# API_ID is a number, no spaces, nothing after it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Your phone in full international form, e.g. +61412345678
TELEGRAM_PHONE=

# -- 2. HyperBot (the app that actually places the bets) --------------
# Your HyperBot API key (whoever gave you this bot provides it).
HYPERBOT_API_KEY=
# Leave the URL exactly as-is.
HYPERBOT_BASE_URL=https://api.hyperbot.imperialwealth.com

# -- 3. Groq (the free AI that reads tip messages) --------------------
# Free key from https://console.groq.com -> API Keys. Starts with gsk_
GROQ_API_KEY=

# -- 4. Your OWN Telegram channels for the bot to post into -----------
# Make a bot via @BotFather in Telegram and paste its token here.
NOTIFY_BOT_TOKEN=
# Channel/group ids (NEGATIVE numbers, e.g. -1001234567890). One group for
# everything is fine to start - put the same id on all five lines.
# placed-bet confirmations:
NOTIFY_SUCCESS_CHAT_ID=
# bets you must place by hand:
NOTIFY_MANUAL_CHAT_ID=
# startup / status messages:
NOTIFY_MAINTENANCE_CHAT_ID=
# urgent problems:
NOTIFY_CRITICAL_CHAT_ID=
# fallback (reuse one of the above):
NOTIFY_CHAT_ID=

# -- 5. Stake sizes (AUD per "1 unit") --------------------------------
# Saiyan = AFL tips.  Shook = NBA + MLB tips.  Start small until you trust it.
SAIYAN_UNIT_SIZE=100
SHOOK_UNIT_SIZE=100
# Never stake more than this many units on one tip. Leave as-is.
MAX_UNITS=3.0
# Leave as-is.
LINE_TOLERANCE=1.0

# -- 6. MLB stake (Shook's MLB is bet at a FLAT dollar amount) --------
# Shook's main MLB play is "2+ HRRBI", which the bot places as a 2-leg
# same-player multi (1+ and 2+) for better odds. MLB ignores the unit
# count and stakes this FLAT $ amount instead.
# KEEP THIS AT 1 until you've watched it place one MLB bet correctly,
# then raise it (e.g. to your real MLB stake). Changing it needs a restart.
MLB_FLAT_STAKE=1

# -- 7. Optional: your OWN test channel -------------------------------
# Make a Telegram GROUP, add the account from section 1, and put its id
# here (negative number). Any tip you POST in that group is placed at just
# $1 - a safe way to prove the bot works before trusting the real tipsters.
# Leave blank to disable. (Posting works because the bot reads your own
# messages in this group.)
SPORTSBOT_TEST_CHANNEL_ID=

# -- 8. Your bookmaker accounts (HyperBot session ids) ----------------
# Comma-separated ids, NO spaces, best account first. The SAME ids must
# also appear as blocks in sessions.yaml. Leave a list BLANK to send that
# bet type to your MANUAL channel instead of auto-placing.
# AFL singles (Saiyan):
AFL_SESSION_PRIORITY=
# AFL multis / SGMs (Saiyan):
AFL_SGM_SESSION_PRIORITY=
# NBA singles (Shook):
NBA_SESSION_PRIORITY=
# NBA multis / SGMs (Shook):
NBA_SGM_SESSION_PRIORITY=
# MLB: Shook's 2+ HRRBI 2-leg multi places on THESE accounts (the main MLB
# auto-play). Put your accounts here.
MLB_SGM_SESSION_PRIORITY=
# MLB singles (other MLB props). Leave BLANK to send them to manual (safest
# - matches how the source bot runs). Fill only if you want them auto-placed.
MLB_SESSION_PRIORITY=
# Accounts to NEVER use for multis (SGMs). Comma-separated, or leave blank.
SGM_BLACKLIST_SESSIONS=

# -- 9. Advanced (leave these alone unless told otherwise) ------------
SESSIONS_YAML_PATH=sessions.yaml
USE_LEGACY_PLACEMENT=false
RECONCILE_AMBIGUOUS=false
RECONCILE_SPILL=false
